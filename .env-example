# Configurações do Flask
FLASK_APP=run.py
FLASK_ENV=development
# Em produção o app recusa subir com placeholder ou chave curta (< 32).
# Gere localmente: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=sua-chave-secreta-aqui

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Senha de acesso ao dashboard (rotas web). Se vazia, o dashboard
# fica aberto sem login (útil em desenvolvimento). Defina em produção.
DASHBOARD_PASSWORD=
# Token de leitura da API (GET /api/feedbacks...) para clientes servidor-a-servidor
# ("Authorization: Bearer <token>", mínimo 24 caracteres). Com este token OU a
# senha acima definidos, a leitura exige credencial; sem nenhum, fica aberta.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_READ_TOKEN=
# Chave de ingestão (POST /api/feedbacks): quem envia feedbacks manda o header
# "X-API-Key: <chave>" (mínimo 24 caracteres; várias separadas por vírgula
# permitem rotacionar sem downtime). Definida, todo POST exige uma chave válida;
# vazia, a ingestão fica aberta e, com chave de LLM no servidor, qualquer um
# gasta a sua cota. Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=
# Demo pública: aceitar sem chave de ingestão quem trouxer a PRÓPRIA chave de LLM
# (headers X-LLM-*). Ainda grava no seu banco; só ligue se aceitar esse volume.
INGEST_ALLOW_BYOK_WITHOUT_KEY=false

# Sessão do painel: validade do login (horas) e tentativas de login por IP.
SESSION_LIFETIME_HOURS=12
RATELIMIT_LOGIN=10 per minute
# Cookie só via HTTPS: true por padrão em produção. Use false só em HTTP local.
# SESSION_COOKIE_SECURE=false

# Limites de entrada da API: corpo da requisição (bytes) e texto do feedback.
MAX_CONTENT_LENGTH=1048576
MAX_FEEDBACK_CHARS=5000

# Configurações do Banco de Dados
# Local: SQLite, sem instalar nada (o arquivo fica em instance/feedlens.db).
# Produção: PostgreSQL, ex.: postgresql://usuario:senha@localhost/feedlens
DATABASE_URL=sqlite:///feedlens.db

# LLM: BYOK multi-provedor via LiteLLM. Nenhuma chave é obrigatória: preencha
# as que tiver (deixe vazias as outras; um placeholder contaria como chave).
# Sem nenhuma, a análise só funciona com BYOK por requisição (headers X-LLM-*).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Groq e OpenRouter têm camada gratuita (com limites); bons como reserva.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Ordem 'provedor/modelo': principal primeiro, depois as reservas. Vazio = todo
# provedor com chave, no modelo padrão (gpt-4o-mini, claude-haiku-4-5,
# gemini-2.5-flash-lite, llama-3.3-70b-versatile, openrouter/free).
# Ex.: gemini/gemini-2.5-flash-lite,groq/llama-3.3-70b-versatile
# No OpenRouter o modelo tem a barra do fabricante: openrouter/google/gemma-4-31b-it:free
LLM_MODELS=
# Timeout (s) e nº de retries por provedor da cadeia
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
# Aceitar a chave do próprio cliente nos headers da API
BYOK_REQUEST_KEYS_ENABLED=True
# Cofre de chaves (tela/API /api/settings/providers): chave Fernet que cifra, no
# banco, as chaves de provedor salvas. Vazia = cofre desligado. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Para rotacionar, use "nova,antiga" e rode `flask rotate-llm-keys`.
FEEDLENS_ENCRYPTION_KEY=
# Teto de testes/cadastros de chave (cada um é uma chamada paga ao provedor)
RATELIMIT_SETTINGS_TEST=10 per minute

# Configurações de Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu-email@gmail.com
EMAIL_PASSWORD=sua-senha-de-app
EMAIL_USE_TLS=True
EMAIL_RECIPIENTS=stakeholder1@feedlens.app,stakeholder2@feedlens.app
# Timeout (s) da conexão SMTP e URL pública do painel (link no e-mail)
EMAIL_TIMEOUT=30
APP_BASE_URL=http://localhost:5000

# Agendador do resumo semanal (segunda às 8h). Ligue em UM processo só: com
# mais de um worker, deixe false no web e rode `python -m app.scheduling`.
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=America/Sao_Paulo

# Rate limiting da API de ingestão (POST /api/feedbacks)
RATELIMIT_ENABLED=True
# memory:// serve para 1 processo; use redis://host:6379 com múltiplos workers
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_INGEST=30 per minute

# CORS: origens permitidas para /api/* (separadas por vírgula). * = qualquer origem.
CORS_ORIGINS=*
